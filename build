#!/bin/sh
# ./build            render only
# ./build "message"  render, then commit and push
set -e
cd "$(dirname "$0")"

quarto render

if [ -z "$1" ]; then
  echo "rendered. pass a message to ship it."
  exit 0
fi

git add -A
if git diff --cached --quiet; then
  echo "nothing to commit"
  exit 0
fi

echo
echo "committing:"
git diff --cached --name-only | sed 's/^/  /'
echo

git commit -q -m "$1"
git push
